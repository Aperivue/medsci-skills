  "date_formats": [
    {
      "label": "Spanish date (DD/MM/YYYY)",
      "pattern": "\\b(0?[1-9]|[12]\\d|3[01])/(0?[1-9]|1[0-2])/(19|20)\\d{2}\\b"
    },
    {
      "label": "Spanish date (DD-MM-YYYY)",
      "pattern": "\\b(0?[1-9]|[12]\\d|3[01])-(0?[1-9]|1[0-2])-(19|20)\\d{2}\\b"
    }
  ],
  "name": "Spain",
