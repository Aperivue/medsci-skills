  "national_id": {
    "label": "DNI / NIE (Documento Nacional de Identidad) + NUSS/NAF (Seguridad Social)",
    "patterns": [
      "\\b\\d{8}[\\s-]?[TRWAGMYFPDXBNJZSQVHLCKET]\\b",
      "\\b[XYZ][\\s-]?\\d{7}[\\s-]?[TRWAGMYFPDXBNJZSQVHLCKET]\\b",
      "\\b\\d{2}[\\s/.-]?\\d{7,8}[\\s/.-]?\\d{2}\\b"
    ],
    "phi_type": "national_id"
  },
  "iban": {
    "label": "IBAN (ES)",
    "phi_type": "bank_account",
    "patterns": [
      "\\bES\\d{2}(?:[\\s.-]?\\d{4}){5}\\b"
    ]
  },
  "native_name": "España",
  "phone": [
    {
      "label": "Spanish mobile/landline",
      "pattern": "\\b[6789]\\d{2}[\\s.\\-]?\\d{3}[\\s.\\-]?\\d{3}\\b"
    },
    {
      "label": "Spanish phone +34",
      "pattern": "(?<!\\d)\\+34[\\s.\\-]?\\d(?:[\\s.\\-]?\\d){8}\\b"
    },
    {
      "label": "Spanish phone 0034",
      "pattern": "(?<!\\d)0034[\\s.\\-]?\\d(?:[\\s.\\-]?\\d){8}\\b"
