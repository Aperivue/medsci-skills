{
 "dataset": "MSD Task09 Spleen (MSKCC) \u2014 Demo 5 internal arm",
 "note": "nnU-Net computes its resampling target and its CT intensity statistics from the dataset fingerprint, which it builds from whatever cases sit in the nnU-Net raw imagesTr folder. Both are therefore DATA-FITTED transforms, and their fit scope is decided by which cases we place there \u2014 not by a flag. The 9 held-out cases are kept out of the nnU-Net dataset entirely, so the fingerprint is fit on the 32 training cases only.",
 "split_seed": 42,
 "transforms": [
  {
   "name": "resample_to_fingerprint_median_spacing",
   "type": "resample",
   "fit_scope": "train",
   "stage": "after_split",
   "applies_to": [
    "train",
    "val",
    "test"
   ],
   "note": "target spacing is the median of the TRAINING fingerprint (Stage-0 profile: 0.61-0.98 mm in-plane, 1.5-8.0 mm through-plane), applied unchanged to held-out cases at inference"
  },
  {
   "name": "ct_foreground_percentile_clip",
   "type": "clip_percentile",
   "fit_scope": "train",
   "stage": "after_split",
   "applies_to": [
    "train",
    "val",
    "test"
   ],
   "note": "0.5/99.5 percentiles of foreground voxels from the training fingerprint"
  },
  {
   "name": "ct_global_zscore",
   "type": "standardize",
   "fit_scope": "train",
   "stage": "after_split",
   "applies_to": [
    "train",
    "val",
    "test"
   ],
   "note": "dataset-level mean/sd of training foreground voxels \u2014 a dataset-fitted transform, not per-image"
  },
  {
   "name": "spatial_and_intensity_augmentation",
   "type": "augmentation",
   "fit_scope": "none",
   "stage": "after_split",
   "applies_to": [
    "train"
   ],
   "note": "nnU-Net default training augmentation; not applied at validation or inference"
  }
 ],
